  "fixed_sql": [
    {
      "name": "task_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color_value\" INTEGER NOT NULL, \"icon_key\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "task_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_items\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"start_at\" INTEGER NULL, \"end_at\" INTEGER NULL, \"scheduled_date\" INTEGER NULL, \"start_time_minutes\" INTEGER NULL, \"duration_minutes\" INTEGER NULL, \"category_id\" TEXT NULL REFERENCES task_categories (id) ON DELETE SET NULL, \"all_day\" INTEGER NOT NULL DEFAULT 0 CHECK (\"all_day\" IN (0, 1)), \"priority\" INTEGER NOT NULL DEFAULT 1, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"recurrence_type\" TEXT NOT NULL DEFAULT 'none', \"recurrence_weekdays\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "task_occurrence_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_occurrence_states\" (\"task_id\" TEXT NOT NULL REFERENCES task_items (id) ON DELETE CASCADE, \"occurrence_date\" INTEGER NOT NULL, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), PRIMARY KEY (\"task_id\", \"occurrence_date\"));"
        }
      ]
    },
    {
      "name": "task_subtasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_subtasks\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES task_items (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "task_subtask_occurrence_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_subtask_occurrence_states\" (\"subtask_id\" TEXT NOT NULL REFERENCES task_subtasks (id) ON DELETE CASCADE, \"occurrence_date\" INTEGER NOT NULL, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), PRIMARY KEY (\"subtask_id\", \"occurrence_date\"));"
        }
      ]
    },
    {
      "name": "task_occurrence_overrides",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_occurrence_overrides\" (\"task_id\" TEXT NOT NULL REFERENCES task_items (id) ON DELETE CASCADE, \"occurrence_date\" INTEGER NOT NULL, \"effective_date\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"start_time_minutes\" INTEGER NULL, \"duration_minutes\" INTEGER NULL, \"category_id\" TEXT NULL REFERENCES task_categories (id) ON DELETE SET NULL, \"all_day\" INTEGER NOT NULL DEFAULT 0 CHECK (\"all_day\" IN (0, 1)), \"priority\" INTEGER NOT NULL DEFAULT 1, \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), PRIMARY KEY (\"task_id\", \"occurrence_date\"));"
        }
      ]
    }
  ]
}